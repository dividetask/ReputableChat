# Runtime state: each server's database lives here.
data/
tmp/
*.db
*.sqlite3
.bundle/
vendor/bundle/
# Seeds are secrets. The one exception is the development genesis account's
# phrase, a public test fixture, un-ignored by name.
*.seed
!server/spec/fixtures/development-genesis.seed

# The host account a server and its apps share: made on the agnostic server's
# first boot, never committed.
/host/

# The chat's (this branch's): the development genesis account's phrases,
# public on purpose so a fresh clone can sign as it, and the browser tests'
# node_modules -- the application itself ships no JavaScript dependencies.
!chat/config/genesis/development.seed
!chat/config/genesis/development.master.seed
node_modules/
