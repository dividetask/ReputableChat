# Runtime state: the database and uploaded images both live here.
data/
tmp/
*.db
*.sqlite3
.bundle/
vendor/bundle/
# Every seed is ignored, and development's are then un-ignored -- the genesis
# account's and the host account's alike. The accident worth guarding against
# is committing a seed, so the default is to refuse and the exception is
# explicit. Development's are public on purpose: anyone who clones the
# repository owns those identities, which is what makes a fresh clone able to
# run both accounts locally.
config/genesis/*.seed
!config/genesis/development.seed
config/host/*.seed
!config/host/development.seed

# Browser tests only. The application itself ships no JavaScript dependencies.
node_modules/
