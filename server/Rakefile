# frozen_string_literal: true

require "rake/testtask"

Rake::TestTask.new(:spec) do |t|
  t.libs << "lib" << "spec" << "spec/support"
  t.test_files = FileList["spec/**/*_spec.rb"]
  t.warning = false
end

desc "Set up a fresh server: its handle, its address, and the servers it knows"
task :setup do
  $LOAD_PATH.unshift File.expand_path("lib", __dir__)
  require "agnostic/setup"
  puts "Written to #{Agnostic::Setup.new(settings: Agnostic::Settings.load).run}"
end

desc "Sweep the chain from servers at once: rake \"sweep[https://a.example,https://b.example]\""
task :sweep, [:url] do |_task, args|
  $LOAD_PATH.unshift File.expand_path("lib", __dir__)
  require "agnostic/server"
  server = Agnostic::Server.new
  urls = [args[:url], *args.extras].compact.map { |u| u.to_s.chomp("/") }
  urls.each { |url| server.store.add_peer(url, source: "settings", at: Time.now.to_i) unless server.store.peer(url) }
  puts "#{server.peers.catch_up(urls)} records new here"
end

desc "List the servers this one syncs with, or has forgotten"
task :peers do
  $LOAD_PATH.unshift File.expand_path("lib", __dir__)
  require "agnostic/settings"
  require "agnostic/store"
  Agnostic::Store.new(Agnostic::Settings.load.database_url).peers.each do |p|
    state = p[:forgotten] ? "forgotten" : (p[:failures].zero? ? "ok" : "#{p[:failures]} failures, next try #{Time.at(p[:next_attempt_at]).utc}")
    puts "#{p[:url]}  #{p[:source]}  #{state}"
  end
end

desc "Show this server's host account, creating it if this is the first run"
task :host do
  $LOAD_PATH.unshift File.expand_path("lib", __dir__)
  require "agnostic/server"
  server = Agnostic::Server.new
  puts JSON.pretty_generate(server.host.to_h.reject { |k, _| k == "declaration" })
end

desc "List the servers this one ignores, and why"
task :ignored do
  $LOAD_PATH.unshift File.expand_path("lib", __dir__)
  require "agnostic/settings"
  require "agnostic/store"
  Agnostic::Store.new(Agnostic::Settings.load.database_url).ignored(at: Time.now.to_i).each do |row|
    puts "#{row[:account]}  until #{Time.at(row[:expires_at]).utc}  #{row[:reason]}"
  end
end

desc "Stop ignoring a server: rake \"forgive[<host account id>]\""
task :forgive, [:account] do |_task, args|
  $LOAD_PATH.unshift File.expand_path("lib", __dir__)
  require "agnostic/settings"
  require "agnostic/store"
  removed = Agnostic::Store.new(Agnostic::Settings.load.database_url).forgive(args[:account].to_s)
  puts removed.zero? ? "#{args[:account]} was not ignored" : "no longer ignoring #{args[:account]}"
end

# Ratings by hand. They go out in this server's next attestation, published
# after its next heartbeat; until then nothing has changed on the chain.
desc "Set an account's rating by hand: rake \"rate[<account id>,<reputation>,<trust>]\", decimals from -1 to 1"
task :rate, [:account, :reputation, :trust] do |_task, args|
  $LOAD_PATH.unshift File.expand_path("lib", __dir__)
  require "agnostic/manual_ratings"
  puts Agnostic::ManualRatings.open.set(args[:account], args[:reputation], args[:trust])
rescue ArgumentError => e
  abort e.message
end

desc "Remove a rating set by hand: rake \"unrate[<account id>]\""
task :unrate, [:account] do |_task, args|
  $LOAD_PATH.unshift File.expand_path("lib", __dir__)
  require "agnostic/manual_ratings"
  puts Agnostic::ManualRatings.open.clear(args[:account])
end

desc "List what this server rates each account, and whether by hand or by reachability"
task :ratings do
  $LOAD_PATH.unshift File.expand_path("lib", __dir__)
  require "agnostic/manual_ratings"
  Agnostic::ManualRatings.open.list.each { |line| puts line }
end

task default: :spec
