# frozen_string_literal: true

require "rake/testtask"

Rake::TestTask.new(:spec) do |t|
  t.libs << "lib" << "spec" << "spec/support"
  t.test_files = FileList["spec/**/*_spec.rb"]
  t.warning = false
end

desc "Show this server's host account, creating it if this is the first run"
task :host do
  $LOAD_PATH.unshift File.expand_path("lib", __dir__)
  require "agnostic/server"
  server = Agnostic::Server.new
  puts JSON.pretty_generate(server.host.to_h.reject { |k, _| k == "declaration" })
end

desc "List the servers this one ignores, and why"
task :ignored do
  $LOAD_PATH.unshift File.expand_path("lib", __dir__)
  require "agnostic/settings"
  require "agnostic/store"
  Agnostic::Store.new(Agnostic::Settings.load.database_url).ignored.each do |row|
    puts "#{row[:account]}  #{Time.at(row[:at]).utc}  #{row[:reason]}"
  end
end

desc "Stop ignoring a server: rake \"forgive[<host account id>]\""
task :forgive, [:account] do |_task, args|
  $LOAD_PATH.unshift File.expand_path("lib", __dir__)
  require "agnostic/settings"
  require "agnostic/store"
  removed = Agnostic::Store.new(Agnostic::Settings.load.database_url).forgive(args[:account].to_s)
  puts removed.zero? ? "#{args[:account]} was not ignored" : "no longer ignoring #{args[:account]}"
end

task default: :spec
